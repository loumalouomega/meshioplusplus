diff -ru a/cmake/modules/macros.cmake b/cmake/modules/macros.cmake
--- a/cmake/modules/macros.cmake
+++ b/cmake/modules/macros.cmake
@@ -7,6 +7,14 @@
 MACRO ( GENERATE_FORTRAN_HEADER name
     in_dir in_file include_dir out_dir out_file
     )
+  IF ( EMSCRIPTEN )
+    # genheader runs perl through system(), which a WebAssembly build run
+    # under node cannot: the Fortran header is a stub there, since the C API
+    # is all a WebAssembly consumer links.
+    FILE ( WRITE ${out_dir}/${out_file}
+      "! The Fortran header is not generated in a WebAssembly build.\n" )
+    ADD_CUSTOM_TARGET ( ${name}_fortran_header ALL )
+  ELSE ( )
   # Wrap add_custom_command into add_custom target to remove dpendencies from
   # the custom command and thus allow parallel build.
   ADD_CUSTOM_COMMAND (
@@ -24,6 +32,7 @@
     ALL
     DEPENDS ${out_dir}/${out_file}
     )
+  ENDIF ( )
 
 ENDMACRO ( )
 
--- a/src/mmg3d/mmg3d1_delone.c
+++ b/src/mmg3d/mmg3d1_delone.c
@@ -39,7 +39,7 @@
 
 #ifndef MMG_PATTERN
 
-int8_t  ddb;
+int8_t  ddb = 0;
 
 #define MMG3D_THRES_DEL     1.6
 #define MMG3D_LOPTL_DEL     1.41
