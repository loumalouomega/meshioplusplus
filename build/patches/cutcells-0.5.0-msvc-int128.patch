+        return neg ? -r : r;
+    }
+    friend int128 operator-(const int128& a)
+    {
+        int128 r;
+        r.lo = ~a.lo + 1;
+        r.hi = ~a.hi + (r.lo == 0 ? 1 : 0);
+        return r;
+    }
+    friend int128 operator+(const int128& a, const int128& b)
+    {
+        int128 r;
+        r.lo = a.lo + b.lo;
+        r.hi = a.hi + b.hi + (r.lo < a.lo ? 1 : 0);
+        return r;
+    }
