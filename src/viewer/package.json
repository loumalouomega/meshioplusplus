{
  "name": "meshioplusplus-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser mesh viewer built on the meshio++ WASM package and vtk.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node tools/link-test-deps.mjs",
    "dev": "vite",
    "build:web": "vite build --outDir dist-web",
    "build:embed": "VITE_VIEWER_EMBEDDED=1 VITE_BASE=./ vite build --outDir dist-embed",
    "preview": "vite preview --outDir dist-web --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:unit": "node ../../tests/viewer/unit/build-and-run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kitware/vtk.js": "32.9.0",
    "@meshioplusplus/wasm": "file:../wasm"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "^5.7.2",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "@babel/runtime": "^7.26.10",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.23",
    "fast-uri": "^3.1.5",
    "browserslist": "^4.28.7"
  }
}
