# Template. The real manifest is generated by `build_extension.py`, which
# substitutes the version, the platform and the wheel list below.
#
# It is generated rather than committed because the bundled wheel file names
# carry the meshio++ version, so a hand-maintained list would rot on the next
# version bump. That keeps CLAUDE.md's version-file list at ten and lets CI
# assert the manifest/pyproject equality instead of anyone remembering it.
#
# Note this header must not itself contain the substitution tokens -- they are
# replaced everywhere in the file, comments included.
schema_version = "1.0.0"

id = "meshioplusplus"
version = "@VERSION@"
name = "meshio++"
tagline = "Import and export 40+ FEA and scientific mesh formats"
maintainer = "Vicente Mataix Ferrandiz <tote1989@gmail.com>"
type = "add-on"

license = ["SPDX:MIT"]
copyright = ["2026 Vicente Mataix Ferrandiz"]
website = "https://loumalouomega.github.io/meshioplusplus/blender.html"

tags = ["Import-Export"]

blender_version_min = "4.2.0"
platforms = ["@PLATFORM@"]

wheels = @WHEELS@

[permissions]
files = "Read and write the mesh files chosen in the import and export dialogs"
