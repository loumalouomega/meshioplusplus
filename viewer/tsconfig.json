{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // Vite/esbuild does the transpiling; tsc is purely a checker.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Mandatory, not laziness: vtk.js 32.9's own .d.ts do not compile standalone.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts"]
}
