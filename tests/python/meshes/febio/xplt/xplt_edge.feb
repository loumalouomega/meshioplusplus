<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>3</time_steps>
		<step_size>0.333333333333</step_size>
		<plot_zero_state>1</plot_zero_state>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
		</solver>
	</Control>
	<Material>
		<material id="1" name="m" type="neo-Hookean"><E>1</E><v>0.3</v></material>
	</Material>
	<Mesh>
		<Nodes>
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">2,0,0</node>
			<node id="4">0,1,0</node>
			<node id="5">1,1,0</node>
			<node id="6">2,1,0</node>
			<node id="7">0,0,1</node>
			<node id="8">1,0,1</node>
			<node id="9">2,0,1</node>
			<node id="10">0,1,1</node>
			<node id="11">1,1,1</node>
			<node id="12">2,1,1</node>
			<node id="13">0.5,0.5,1.25</node>
			<node id="14">1,0.5,1.25</node>
			<node id="15">1.5,0.5,1.25</node>
		</Nodes>
		<Elements type="hex8" name="bar">
			<elem id="1">1,2,5,4,7,8,11,10</elem>
			<elem id="2">2,3,6,5,8,9,12,11</elem>
		</Elements>
		<NodeSet name="fixed">1,7,4,10</NodeSet>
		<NodeSet name="pull">3,9,6,12</NodeSet>
		<Surface name="top">
			<quad4 id="1">7,8,11,10</quad4>
			<quad4 id="2">8,9,12,11</quad4>
		</Surface>
		<Edge name="ridge">
			<line2 id="1">13,14</line2>
			<line2 id="2">14,15</line2>
		</Edge>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="bar" mat="m"/>
	</MeshDomains>
	<Boundary>
		<bc type="zero displacement" node_set="fixed">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof>
		</bc>
		<bc type="prescribed displacement" node_set="pull"><dof>z</dof><value lc="1">0.2</value></bc>
	</Boundary>
	<Constraints>
		<constraint type="edge-to-surface sliding contact" surface="top"><edgelist>ridge</edgelist><penalty>1</penalty></constraint>
	</Constraints>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="edge contact gap"/>
		</plotfile>
	</Output>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
</febio_spec>
