[codespell]
# Words that are identifiers, format keywords or domain terms in this project, not typos.
ignore-words-list = crate,socio-economic,mater,methode,rin,nd,rsource,rsources,te,ue,fo,noe,inout,bu,ot,ser,coo,thi,nin,pring,kinf,allowin,merrors,trys,numer,infor,tread,topologie,termine,pres,ect,wit,clen,groupe,positionof,ther,childs,domin,ans,ba,ond,nam,tre,hist,fpr,lod,ois,mis,afe,delt,nd,ro,claus,alo,regraded,precice,suport,statics,unparseable,invers,commun,vermillion,rmoved,rmove,rcall,nax,entrie,dragable,infront,dout,vor,iterm,abd,hel,ths,crasher,conver,valide,caf,nast,re-use,re-declaring,re-declare,pixelx,isnt,notin,curren,synopsys,uper,anc,ist,trough,withh,re-declares
# Fixtures, generated files, third-party code and binary-ish data.
skip = */third_party/*,*/meshes/*,*/regressions/*,*.vtp,*.patch,*.pdf,*.html,*.svg,*.ipynb,*.json,*.csv,*.lock,package-lock.json,third_party,single_include,node_modules,meshes,input,.git,*.bib,*.npz,.vitepress,doxygen-build,build,.venv,*.vtu,*.msh,*.vtk,*.med,*.f3grid
